# gmc-exporter configuration.
#
# Copy to .env and fill in. NEVER commit the filled-in file: .env is gitignored
# for exactly this reason.
#
# Every secret setting also accepts a _FILE variant naming a file to read the
# value from, for example GOGMC_RADMON_PASSWORD_FILE=/run/secrets/radmon.
# Prefer that in production: a plain environment variable is visible to anyone
# who can run `docker inspect`, and is inherited by every child process.
# Setting both the plain and _FILE form of the same setting is an error rather
# than a silent preference.

# ---------------------------------------------------------------------------
# Device
# ---------------------------------------------------------------------------
GOGMC_SERIAL_PORT=/dev/ttyUSB0
GOGMC_SERIAL_BAUD=115200

# Bounds one complete response. Measured worst-case first-byte latency on a
# GMC-320 was 171ms, so the 2s default leaves a wide margin.
GOGMC_SERIAL_RESPONSE_TIMEOUT=2s

# Per-read poll granularity, not a response budget.
GOGMC_SERIAL_READ_TIMEOUT=50ms

# ---------------------------------------------------------------------------
# Sampling
# ---------------------------------------------------------------------------
GOGMC_POLL_INTERVAL=60s

# How many samples contribute to the running average.
GOGMC_AVERAGE_WINDOW=60

# Optional. Overrides the calibration table read from the device, as
# comma-separated cpm:usv pairs. The layout of the device's config block is
# measured rather than documented by the vendor, so this is the escape hatch if
# a unit stores it differently. The value below is what a GMC-320 reports.
# GOGMC_CALIBRATION=60:0.39,240:1.56,1000:6.5

# ---------------------------------------------------------------------------
# Logging and HTTP
# ---------------------------------------------------------------------------
GOGMC_LOG_LEVEL=info
GOGMC_LOG_FORMAT=json

# Serves /metrics, /healthz, /readyz and /health.
GOGMC_HTTP_ADDR=:9101

# How long without a successful read before /readyz reports unhealthy.
# Defaults to three poll intervals when unset.
# GOGMC_HTTP_STALE_AFTER=180s

# ---------------------------------------------------------------------------
# Location
#
# Required by GMCMAP, Safecast, and radmon's submitwithlatlng.
#
# THIS DATA IS PUBLISHED PUBLICLY. It is attached to every reading sent to a
# public radiation map and cannot be recalled. Consider whether you want your
# home address discoverable to that precision before setting it. Sinks that
# need coordinates refuse to start without them rather than sending a default.
# ---------------------------------------------------------------------------
# GOGMC_LATITUDE=35.6812
# GOGMC_LONGITUDE=139.7671

# ---------------------------------------------------------------------------
# Sinks. Every one is disabled by default; enable only what you use.
# ---------------------------------------------------------------------------

# Prometheus. The most robust option: no credentials, cannot stall the poll
# loop, and keeps working when backends change. Scrape GOGMC_HTTP_ADDR.
GOGMC_PROMETHEUS_ENABLED=true
GOGMC_PROMETHEUS_PATH=/metrics

# radmon.org
# The password is radmon's separate DATA-SENDING password, which is not your
# account login password.
GOGMC_RADMON_ENABLED=false
GOGMC_RADMON_USER=
GOGMC_RADMON_PASSWORD=
# GOGMC_RADMON_PASSWORD_FILE=/run/secrets/radmon_password
GOGMC_RADMON_USE_LATLNG=false

# InfluxDB 1.x
GOGMC_INFLUX1_ENABLED=false
GOGMC_INFLUX1_URL=http://influxdb:8086
GOGMC_INFLUX1_DATABASE=radiation
GOGMC_INFLUX1_USER=
GOGMC_INFLUX1_PASSWORD=
# GOGMC_INFLUX1_PASSWORD_FILE=/run/secrets/influx1_password
GOGMC_INFLUX1_MEASUREMENT=radiation

# Field key naming. "snake" (default) matches the other sinks: cpm, acpm,
# usvh, volts, temp_c. "legacy" reproduces the schema of the older, unmaintained
# GoGMC320 exporter -- CPM, ACPM, USV, Voltage, Temperature -- so this exporter
# can continue an existing series instead of starting a parallel one beside it.
# If you are replacing that exporter, set this to legacy and point
# GOGMC_INFLUX1_MEASUREMENT at the measurement it was already writing.
GOGMC_INFLUX1_FIELD_STYLE=snake

# Tag each point with the device serial and version. Both are single-valued for
# a given instrument, so this adds no cardinality.
GOGMC_INFLUX1_TAG_DEVICE=true

# InfluxDB 2.x
GOGMC_INFLUX2_ENABLED=false
GOGMC_INFLUX2_URL=http://influxdb2:8086
GOGMC_INFLUX2_ORG=
GOGMC_INFLUX2_BUCKET=
GOGMC_INFLUX2_TOKEN=
# GOGMC_INFLUX2_TOKEN_FILE=/run/secrets/influx2_token
GOGMC_INFLUX2_MEASUREMENT=radiation

# OpenTelemetry. Grafana Alloy is natively an OTLP receiver.
GOGMC_OTLP_ENABLED=false
GOGMC_OTLP_PROTOCOL=grpc
GOGMC_OTLP_ENDPOINT=alloy:4317
GOGMC_OTLP_INSECURE=true
# Comma-separated key=value pairs. Values are never logged.
# GOGMC_OTLP_HEADERS=authorization=Bearer xxx

# MQTT, with optional Home Assistant discovery.
GOGMC_MQTT_ENABLED=false
GOGMC_MQTT_BROKER=mqtt.example.lan
GOGMC_MQTT_PORT=1883
GOGMC_MQTT_TLS=false
GOGMC_MQTT_USERNAME=
GOGMC_MQTT_PASSWORD=
# GOGMC_MQTT_PASSWORD_FILE=/run/secrets/mqtt_password
GOGMC_MQTT_CLIENT_ID=gmc-exporter
GOGMC_MQTT_QOS=1
GOGMC_MQTT_BASE_TOPIC=gmc-exporter
GOGMC_MQTT_RETAIN=true
GOGMC_MQTT_HA_DISCOVERY=false
GOGMC_MQTT_HA_PREFIX=homeassistant
GOGMC_MQTT_DEVICE_NAME=Geiger Counter
# TLS options, only valid when GOGMC_MQTT_TLS=true
# GOGMC_MQTT_CA_CERT=/etc/ssl/certs/broker-ca.pem
# GOGMC_MQTT_CLIENT_CERT=/etc/ssl/certs/client.pem
# GOGMC_MQTT_CLIENT_KEY=/etc/ssl/private/client.key

# GMCMAP.com. Requires GOGMC_LATITUDE and GOGMC_LONGITUDE.
GOGMC_GMCMAP_ENABLED=false
GOGMC_GMCMAP_ACCOUNT_ID=
GOGMC_GMCMAP_COUNTER_ID=
# GOGMC_GMCMAP_COUNTER_ID_FILE=/run/secrets/gmcmap_counter_id

# Safecast. Requires GOGMC_LATITUDE and GOGMC_LONGITUDE.
GOGMC_SAFECAST_ENABLED=false
GOGMC_SAFECAST_API_KEY=
# GOGMC_SAFECAST_API_KEY_FILE=/run/secrets/safecast_api_key
GOGMC_SAFECAST_DEVICE_ID=0
